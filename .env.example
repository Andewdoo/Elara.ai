# App URLs and CORS
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# DeepSeek API - server side only
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
# Optional; leave unset until an approved DeepSeek-compatible embedding route exists.
DEEPSEEK_EMBEDDING_MODEL=

# Brave Search - server side only
SEARCH_PROVIDER=brave
SEARCH_API_KEY=replace-with-brave-search-api-key
SEARCH_BASE_URL=https://api.search.brave.com/res/v1
SEARCH_CACHE_TTL_SECONDS=3600
FETCH_CACHE_TTL_SECONDS=21600
FETCH_CONNECT_TIMEOUT_SECONDS=5
FETCH_READ_TIMEOUT_SECONDS=10
FETCH_TOTAL_TIMEOUT_SECONDS=20
FETCH_MAX_REDIRECTS=3
FETCH_NETWORK_RETRIES=1
FETCH_MAX_HTML_BYTES=5000000
FETCH_MAX_PDF_BYTES=25000000
FETCH_ALLOWED_PORTS=80,443
# Must be outside the application/code directory in deployed workers.
FETCH_STORAGE_DIR=/var/lib/elara/fetched-sources

# Firebase Web config - public browser metadata
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id

# Firebase Admin - server side only
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# PostgreSQL / pgvector
POSTGRES_DB=elara
POSTGRES_USER=elara
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+psycopg://elara:replace-with-local-password@localhost:5432/elara
PASSAGE_EMBEDDING_DIMENSION=1536

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_PROGRESS_MAX_EVENTS=1000
REDIS_PROGRESS_TTL_SECONDS=86400
REDIS_CANCELLATION_TTL_SECONDS=86400
REDIS_LOCK_TTL_SECONDS=3600
SSE_HEARTBEAT_SECONDS=20

# S3-compatible object storage - server side only
S3_ENDPOINT_URL=http://localhost:9000
# Browser-reachable origin used only when signing authorized downloads.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_BUCKET_NAME=elara-local
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
EXPORT_SIGNED_URL_TTL_SECONDS=300

# Sentry
NEXT_PUBLIC_SENTRY_DSN=replace-with-public-web-sentry-dsn
SENTRY_DSN_API=replace-with-api-sentry-dsn
SENTRY_DSN_WORKER=replace-with-worker-sentry-dsn
SENTRY_ORG=replace-with-sentry-org
SENTRY_PROJECT_WEB=replace-with-sentry-web-project
SENTRY_PROJECT_API=replace-with-sentry-api-project
SENTRY_PROJECT_WORKER=replace-with-sentry-worker-project
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
SENTRY_TRACES_SAMPLE_RATE=0.05

# LangSmith-compatible tracing - server side only
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=replace-with-langsmith-api-key
LANGSMITH_PROJECT=elara-local

# Optional pricing inputs for aggregate cost-per-verification metrics.
DEEPSEEK_INPUT_COST_PER_MILLION_TOKENS=0
DEEPSEEK_OUTPUT_COST_PER_MILLION_TOKENS=0
SEARCH_COST_PER_REQUEST=0
